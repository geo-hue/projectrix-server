<!-- templates/emails/subscription-expiry.ejs -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Projectrix Pro Subscription Has Expired</title>
  <style>
    /* Reset styles */
    body, html {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: #333;
      background-color: #f9f9f9;
    }
    
    /* Container */
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
    }
    
    /* Header */
    .header {
      text-align: center;
      padding: 20px 0;
      border-bottom: 1px solid #eaeaea;
    }
    
    /* Logo */
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&display=swap');
    
    .logo-text {
      font-family: 'Orbitron', sans-serif;
      font-size: 32px;
      font-weight: 700;
      background: linear-gradient(to right, #1e3a8a, #2563eb);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 2px;
      position: relative;
      display: inline-block;
      padding-bottom: 5px;
    }
    
    .logo-text::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(to right, #1e3a8a, #2563eb);
      transition: width 0.3s ease;
    }
    
    .logo-container:hover .logo-text::after {
      width: 100%;
    }
    
    /* Content */
    .content {
      padding: 20px 0;
    }
    
    h1 {
      color: #2563eb;
      margin-top: 0;
      font-size: 24px;
    }
    
    .highlight {
      font-weight: bold;
      color: #2563eb;
    }
    
    /* Features */
    .features {
      margin: 20px 0;
      padding: 15px;
      background-color: #f3f4f6;
      border-radius: 8px;
    }
    
    .feature {
      margin-bottom: 15px;
      display: flex;
    }
    
    .feature-icon {
      flex: 0 0 30px;
      font-size: 18px;
      color: #2563eb;
      margin-right: 10px;
    }
    
    .feature-text {
      flex: 1;
    }
    
    /* CTA Button */
    .cta-button {
      display: block;
      text-align: center;
      margin: 30px auto;
      padding: 12px 24px;
      background-color: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 4px;
      font-weight: bold;
      max-width: 200px;
      transition: background-color 0.3s;
    }
    
    .cta-button:hover {
      background-color: #1d4ed8;
    }
    
    /* Footer */
    .footer {
      text-align: center;
      padding: 20px 0;
      border-top: 1px solid #eaeaea;
      font-size: 12px;
      color: #6b7280;
    }
    
    .social-links {
      margin: 15px 0;
    }
    
    .social-link {
      display: inline-block;
      margin: 0 10px;
      color: #2563eb;
      text-decoration: none;
    }
    
    .unsubscribe {
      color: #6b7280;
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <a href="https://projectrix.vercel.app" class="logo-container">
        <div class="logo-text">PROJECTRIX</div>
      </a>
    </div>
    
    <div class="content">
      <h1>Your Pro Subscription Has Expired, <%= name %></h1>
      
      <p>We noticed that your Projectrix Pro subscription has expired, and your account has been automatically switched to the free plan.</p>
      
      <div class="features">
        <div class="feature">
          <div class="feature-icon">📉</div>
          <div class="feature-text">
            <strong>What this means:</strong> Your account has been downgraded to the free plan, which includes:
            <ul>
              <li>3 project ideas per month</li>
              <li>Limited collaboration requests (3 per month)</li>
              <li>1 active collaboration at a time</li>
              <li>1 published project maximum</li>
              <li>2 AI enhancements per month</li>
            </ul>
          </div>
        </div>
        
        <div class="feature">
          <div class="feature-icon">✨</div>
          <div class="feature-text">
            <strong>Reactivate Pro:</strong> To regain access to all Pro features, including unlimited collaborations, 10 project ideas monthly, 8 AI enhancements, and more, you can resubscribe to the Pro plan at any time.
          </div>
        </div>
      </div>
      
      <p>We value your contributions to the Projectrix community and hope you'll continue to collaborate on amazing projects with us!</p>
      
      <a href="https://projectrix.vercel.app/pricing" class="cta-button">Reactivate Pro</a>
      
      <p>If you have any questions or need assistance, please don't hesitate to reach out to our support team at <a href="mailto:support@projectrix.io">support@projectrix.io</a>.</p>
      
      <p>Best regards,<br>The Projectrix Team</p>
    </div>
    
    <div class="footer">
      <div class="social-links">
        <a href="https://github.com/projectrix" class="social-link">GitHub</a>
        <a href="https://twitter.com/projectrix" class="social-link">Twitter</a>
        <a href="https://discord.gg/projectrix" class="social-link">Discord</a>
      </div>
      
      <p>You're receiving this email because you had an active subscription to Projectrix Pro.</p>
      
      <p>
        <a href="https://projectrix.vercel.app/unsubscribe?email=<%= userEmail %>" class="unsubscribe">Unsubscribe</a> |
        <a href="https://projectrix.vercel.app/privacy" class="unsubscribe">Privacy Policy</a>
      </p>
      
      <p>&copy; <%= year %> Projectrix. All rights reserved.</p>
    </div>
  </div>
</body>
</html>